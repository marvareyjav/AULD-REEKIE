{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role management",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Menu": {
      "title": "Menu",
      "description": "Coffee shop items",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "items": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "complaint": { "type": "string" }
      },
      "required": ["userId", "items", "total", "status"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Storage for user profile data"
    },
    "menu": {
      "schema": "Menu",
      "description": "Storage for coffee shop menu items"
    },
    "orders": {
      "schema": "Order",
      "description": "Storage for customer orders"
    }
  }
}
